{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.fairmind.example/agent-api/v1/code-change-request.schema.json",
  "title": "POST /v1/context:for-code-change request body (v1)",
  "description": "Metadata only: no file contents are ever sent (spec §33).",
  "type": "object",
  "required": ["mode", "changes"],
  "additionalProperties": false,
  "properties": {
    "mode": { "enum": ["diff", "files"] },
    "project": { "type": "string" },
    "budget_tokens": { "type": "integer", "minimum": 256, "maximum": 200000 },
    "repository": {
      "type": "object",
      "description": "Resolved server-side in order explicit -> remote -> binding -> configured (spec §22).",
      "additionalProperties": false,
      "properties": {
        "explicit": { "type": "string" },
        "remote": { "type": "string", "description": "normalized host/owner/name, never with credentials" },
        "branch": { "type": "string" },
        "head_commit": { "type": "string" },
        "configured": { "type": "string" }
      }
    },
    "changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": ["path", "status"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "old_path": { "type": "string" },
          "status": { "enum": ["added", "modified", "deleted", "renamed", "copied", "typechange", "unmerged", "untracked", "unspecified"] },
          "additions": { "type": "integer" },
          "deletions": { "type": "integer" },
          "binary": { "type": "boolean" },
          "hunks": { "type": "array", "items": { "type": "object", "required": ["start", "lines"],
            "properties": { "start": { "type": "integer" }, "lines": { "type": "integer" } } } },
          "symbols": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
